set_driving_cell -lib_cell INVX1 [get_ports                                    \
invaderbullet_player_collision_signal]
set_driving_cell -lib_cell INVX1 [get_ports                                    \
invaderbullet_shield_collision_signal]
set_driving_cell -lib_cell INVX1 [get_ports invader_outofbounds_signal_1]
set_driving_cell -lib_cell INVX1 [get_ports invader_outofbounds_signal_2]
create_clock [get_ports clka]  -period 20  -waveform {0 10}
set_input_delay -clock clka  1  [get_ports clkb]
set_input_delay -clock clka  1  [get_ports global_reset]
set_input_delay -clock clka  1  [get_ports player_left_input]
set_input_delay -clock clka  1  [get_ports player_right_input]
