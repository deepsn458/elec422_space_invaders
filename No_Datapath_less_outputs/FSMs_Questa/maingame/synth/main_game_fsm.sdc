# Created by write_sdc on Mon May  4 11:25:22 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_driving_cell -lib_cell INVX1 [get_ports clka]
set_driving_cell -lib_cell INVX1 [get_ports clkb]
set_driving_cell -lib_cell INVX1 [get_ports global_reset]
set_driving_cell -lib_cell INVX1 [get_ports player_left_input]
set_driving_cell -lib_cell INVX1 [get_ports player_right_input]
set_driving_cell -lib_cell INVX1 [get_ports player_shoot_input]
set_driving_cell -lib_cell INVX1 [get_ports player_display]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_x[3]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_x[2]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_x[1]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_x[0]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_y[3]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_y[2]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_y[1]}]
set_driving_cell -lib_cell INVX1 [get_ports {player_coordinate_y[0]}]
set_driving_cell -lib_cell INVX1 [get_ports {invaders_display[1]}]
set_driving_cell -lib_cell INVX1 [get_ports {invaders_display[0]}]
